# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment
.env

# Database (real production data must NEVER be committed -- covers the
# live finance.db plus any timestamped/backup copy such as
# finance.db.bak-<task>-<timestamp>, and SQLite's -shm/-wal side files)
data/*.db
data/*.db-shm
data/*.db-wal
data/*.db.bak-*
data/*.bak*

# Application data
data/imports/
data/exports/
data/backups/
data/attachments/

# FUSE mount transient artifacts (Cowork/device-bridge temp files)
.fuse_hidden*
data/.fuse_hidden*

# Node / Next.js
node_modules/
.next/

# IDE
.vscode/
.idea/

# TypeScript incremental build cache
*.tsbuildinfo

# Transient test artifacts
playwright-report/
test-results/
e2e-results.json

# Locally generated AI context dump (regenerable, ~4MB, duplicates
# tracked source -- not meant to be version-controlled)
project-context.md

# Project local backups and temp archives
backup/
_to_delete/
